import os
import sys
import signal
import locale
import gettext

VERSION = '0.1.0'
pkgdatadir = '/home/eiji-otieno/Projects/mophic/_install/share/mophic'
localedir = '/home/eiji-otieno/Projects/mophic/_install/share/locale'

sys.path.insert(1, pkgdatadir)
signal.signal(signal.SIGINT, signal.SIG_DFL)
locale.bindtextdomain('mophic', localedir)
locale.textdomain('mophic')
gettext.bindtextdomain('mophic', localedir)
gettext.textdomain('mophic')

if __name__ == '__main__':
    import gi

    from gi.repository import Gio
    resource = Gio.Resource.load(os.path.join(pkgdatadir, 'mophic.gresource'))
    resource._register()

    from mophic import main
    sys.exit(main.main(VERSION))
